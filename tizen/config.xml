<?xml version="1.0" encoding="UTF-8"?>
<!-- Plantilla. Valida contra la plantilla "TV > Web Application > Empty" de Tizen Studio / extensión de VS Code
     y ajusta id, package y versión antes de firmar. -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://example.com/tvlauncher" version="4.0.0" viewmodes="maximized">
    <tizen:application id="TVLaunch01.TVLauncher" package="TVLaunch01" required_version="6.5"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <icon src="icon.png"/>
    <name>TV Launcher</name>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <access origin="*" subdomains="true"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto"/>
</widget>
